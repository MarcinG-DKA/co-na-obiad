---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";

const { user, householdId } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let inviteCode: string | null = null;
if (supabase && householdId) {
  const { data } = await supabase.from("households").select("invite_code").eq("id", householdId).maybeSingle();
  inviteCode = data?.invite_code ?? null;
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
      data-household-id={householdId ?? ""}
    >
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="text-blue-100/80">
        Welcome, <span class="font-semibold text-white">{user?.email}</span>
      </p>
      {
        inviteCode ? (
          <p class="mt-4 text-sm text-blue-100/80">
            Invite code: <code class="font-mono break-all text-white">{inviteCode}</code>
          </p>
        ) : (
          <p class="mt-4 text-sm text-blue-100/50">No household</p>
        )
      }
      <p class="mt-2 text-sm text-blue-100/60">
        <a href="/join" class="text-purple-300 hover:underline">Join another household</a>
      </p>
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>
